pipeline {
    agent any

    environment {
        APP_ENV = 'staging'
    }

    stages {
        stage('Build') {
            steps {
                retry(3) {
                    sh 'echo Build successful'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    try {
                        sh 'echo Test successful'
                    } catch (err) {
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
    }
}
